# === Nexa Referral Bot Config ===

# Get this from @BotFather after creating your bot
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your channel's numeric ID (must start with -100 for channels/supergroups)
# Easiest way to get it: temporarily add @userinfobot or @RawDataBot to your channel as admin,
# or forward a message from the channel to @JsonDumpBot
CHANNEL_ID=-1001234567890

# Your channel's public @username WITHOUT the @ (used for display only, e.g. in /help)
CHANNEL_USERNAME=nexapropfirm

# How many Nexa Points a user earns per successful referral (a new member joining via their link)
POINTS_PER_REFERRAL=10

# Comma-separated Telegram user IDs who can use admin commands (/leaderboard, /addpoints, /removepoints, /broadcast)
# Get your own ID by messaging @userinfobot
ADMIN_IDS=123456789
